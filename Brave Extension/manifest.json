{
  "manifest_version": 3,
  "name": "Keep Widgets Importer",
  "version": "1.0.0",
  "description": "Отправляет открытую заметку Google Keep в локальные виджеты macOS.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:43821/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://keep.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
